# Machine-local Spec Kit state — not meant to be shared.
# Managed by the Specify CLI; safe to edit (your changes are preserved on refresh).

# Local pointer to the current feature directory. Rewritten every time you
# switch features, so it is per-checkout state rather than something to share.
feature.json

# Per-machine extension config overrides.
extensions/*/local-config.yml

# Per-checkout workflow progress counter (same class as feature.json above).
.runtime/

# Python bytecode from the bundled helper scripts.
scripts/python/__pycache__/

# Bash copies of the helper scripts. This project is configured script: "py"
# (see init-options.json), so these are never invoked. Kept on disk because
# integrations/speckit.manifest.json tracks their checksums.
scripts/bash/
