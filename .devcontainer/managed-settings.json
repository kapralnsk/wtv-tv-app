{
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(gh pr review *)",
      "Bash(gh api *APPROVE*)",
      "Edit(//workspace/LICENSE.md)",
      "Edit(//workspace/.specify/memory/constitution.md)",
      "Edit(//workspace/AGENTS.md)",
      "Edit(//workspace/REVIEW.md)",
      "Edit(//workspace/docs/answering-reviews.md)",
      "Edit(//workspace/docs/phases.md)",
      "Edit(//workspace/.claude/skills/**)",
      "Edit(//workspace/.devcontainer/managed-settings.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/wtv-devcontainer/check-workspace.sh || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
